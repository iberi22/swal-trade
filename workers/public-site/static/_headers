/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# El worker impone la CSP final por ruta (src/worker.js cspFor). Se repite aqui para el caso de
# assets servidos sin pasar por el worker.
/checkout/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' https://pay.swal.network

/guardian/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' https://fapi.binance.com https://api.binance.com https://api.telegram.org https://pay.swal.network

/analisis/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' https://fapi.binance.com wss://fstream.binance.com https://api.alternative.me

/backup/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' https://pay.swal.network

/*.css
  Cache-Control: public, max-age=300, must-revalidate
/*.js
  Cache-Control: public, max-age=300, must-revalidate

# PWA: el service worker se comprueba en cada carga (no-cache) y puede controlar todo el
# origen; el manifiesto lleva su tipo correcto y una cache corta. Van despues de /*.js
# porque el ultimo bloque que coincide es el que manda.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

/icons/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
/*.html
  Cache-Control: no-cache
/*/
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
