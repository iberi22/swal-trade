{
  "name": "@swal-trade/mcp",
  "version": "0.1.0",
  "description": "Servidor MCP de solo lectura para análisis de gráficos, contexto de mercado y riesgo de cuenta de swal-trade.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "swal-trade-mcp": "./dist/index.js",
    "swal-bridge": "./dist/bridge-daemon.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "core",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "bridge": "node dist/bridge-daemon.js",
    "prepack": "npm run build && node scripts/bundle-core.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/swal-trade.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://trade.swal.network/extension/",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "binance",
    "trading",
    "risk",
    "claude-code",
    "codex",
    "gemini-cli"
  ]
}
